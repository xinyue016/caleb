# Server
HOST=0.0.0.0
PORT=8787

# Model provider: mock | openai | openai_compatible | ollama
CALEB_PROVIDER=mock
CALEB_MODEL=gpt-5.1
OPENAI_API_KEY=
CALEB_BASE_URL=https://api.openai.com/v1
CALEB_TEMPERATURE=0.82
CALEB_MAX_OUTPUT_TOKENS=700
CALEB_HISTORY_LIMIT=14

# WeChat Official Account
WECHAT_TOKEN=
WECHAT_PLAIN_MODE=true

# QQ Official Bot
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
QQ_BOT_PRIVATE_KEY=
QQ_BOT_PUBLIC_KEY=
QQ_BOT_API_BASE=https://api.sgroup.qq.com
QQ_BOT_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken

# Set false if you temporarily want to disable connector webhooks
CALEB_ALLOW_PUBLIC_WEBHOOKS=true
